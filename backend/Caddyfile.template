# Caddy edge — auto-TLS for bot.tingting.vip.
# This is a TEMPLATE: scripts/flip_caddy.sh renders __WEB_UPSTREAM__ to the
# active blue/green color (web-blue or web-green) and `caddy reload`s. Do not
# edit /opt/vfic/Caddyfile directly — regenerate it from this file.
# /webhooks, /api, /realtime, /socket.io -> FastAPI (active web-<color>:8000);
# everything else -> the frontend nginx image (frontend:80). apiBaseUrl defaults
# to same-origin, so the SPA needs no deploy-time env injection.
bot.tingting.vip {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# default-src 'self' pins every fetch to this origin. The explicit sources
		# are what the SPA actually loads: the Google Fonts stylesheet and its font
		# files; blob:/data: for the object-URL image previews (file inputs, avatar
		# previews); and the provider image CDNs, because contact avatars are
		# rendered straight from the URL the Zalo OA / Messenger profile APIs
		# returned (nothing proxies them). Add a host here rather than widening to
		# a bare `https:` scheme source. style-src needs 'unsafe-inline' because
		# index.html ships an inline <style> loader block and React sets inline
		# style attributes; a nonce/hash policy cannot cover the attribute form.
		Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data: https://*.zadn.vn https://*.fbcdn.net https://*.fbsbx.com"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing in the console uses these device APIs; clipboard-write stays
		# enabled for the credential copy buttons.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	handle /webhooks/* {
		reverse_proxy __WEB_UPSTREAM__:8000
	}

	# Public liveness probe -> backend JSON health (not the SPA).
	handle /health {
		reverse_proxy __WEB_UPSTREAM__:8000
	}

	handle /api/* {
		reverse_proxy __WEB_UPSTREAM__:8000
	}

	# SSE: disable buffering so events flush to the client immediately.
	handle /realtime/* {
		reverse_proxy __WEB_UPSTREAM__:8000 {
			flush_interval -1
		}
	}

	# Socket.IO realtime (WebSocket + polling). reverse_proxy transparently
	# upgrades the WS connection, so wss://<origin>/socket.io/ works here.
	handle /socket.io/* {
		reverse_proxy __WEB_UPSTREAM__:8000
	}

	# SPA (react-admin) served by the frontend image.
	handle {
		reverse_proxy frontend:80
	}
}
