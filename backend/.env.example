# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (the CRM + dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://bot.tingting.vip

# ---- Database (self-hosted Postgres 16 + pgvector) ----
# DEV (`make dev`): these are rewritten to localhost automatically.
# PROD: docker-compose.yml service name `postgres`; password via POSTGRES_PASSWORD
#       (generated by scripts/prod-env.sh on first deploy).
POSTGRES_USER=vfic
POSTGRES_PASSWORD=vfic
POSTGRES_DB=vfic
# async driver (app runtime)
DATABASE_URL=postgresql+asyncpg://vfic:vfic@postgres:5432/vfic
# sync driver (Alembic + ETL script)
DATABASE_URL_SYNC=postgresql+psycopg://vfic:vfic@postgres:5432/vfic

# ---- Redis (RQ broker + per-chat mutex + pub/sub) ----
# DEV: no password. PROD: REDIS_PASSWORD set + embedded in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---- Auth (JWT, replaces Supabase Auth) ----
JWT_SECRET=change-me-please-32-chars-minimum-aaaa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Zalo OA (webhook verify + send). NEVER exposed to frontend. ----
ZALO_OA_TOKEN=
ZALO_OA_OAID=
ZALO_API_BASE=https://openapi.zalo.me

# ---- LLM: MiniMax (OpenAI-compatible). Agent + safety. KEPT from n8n. ----
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_AGENT_MODEL=MiniMax-M2.7-highspeed
MINIMAX_SAFETY_MODEL=MiniMax-M2.5-highspeed
MINIMAX_REQUEST_TIMEOUT=60

# ---- Embeddings: Google Gemini (3072-dim). KEPT from n8n. ----
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# ---- Google Drive (knowledge ingest, P5) ----
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ---- Runtime ----
WEB_CONCURRENCY=2
