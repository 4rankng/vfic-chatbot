# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (the CRM + dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://bot.tingting.vip

# ---- Database (self-hosted Postgres 16 + pgvector) ----
# DEV (`make dev`): these are rewritten to localhost automatically.
# PROD: docker-compose.yml service name `postgres`; password via POSTGRES_PASSWORD
#       (generated by scripts/prod-env.sh on first deploy).
POSTGRES_USER=vfic
POSTGRES_PASSWORD=vfic
POSTGRES_DB=vfic
# async driver (app runtime)
DATABASE_URL=postgresql+asyncpg://vfic:vfic@postgres:5432/vfic
# sync driver (Alembic + ETL script)
DATABASE_URL_SYNC=postgresql+psycopg://vfic:vfic@postgres:5432/vfic

# ---- Redis (RQ broker + per-chat mutex + pub/sub) ----
# DEV: no password. PROD: REDIS_PASSWORD set + embedded in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---- Auth (JWT, replaces Supabase Auth) ----
JWT_SECRET=change-me-please-32-chars-minimum-aaaa
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Zalo Bot Platform (bot-api.zaloplatforms.com) — the single Zalo integration. ----
# NEVER exposed to frontend.
# ZALO_BOT_TOKEN: the Bot Platform bot token (rides in the URL path /bot{TOKEN}/{method}).
#   REQUIRED to send replies. From the Bot Platform console (bot.zaloplatforms.com).
# ZALO_BOT_WEBHOOK_SECRET: the secret_token you passed to setWebhook; Zalo echoes it in
#   the X-Bot-Api-Secret-Token header on every inbound POST. REQUIRED in prod
#   (blank -> webhook fails closed 503 in non-dev).
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_API_BASE=https://bot-api.zaloplatforms.com
ZALO_BOT_REQUEST_TIMEOUT=30
# The webhook URL currently registered with Zalo. Optional; status/self-test only.
ZALO_BOT_WEBHOOK_URL=

# ---- LLM providers (OpenAI-compatible). Enable exactly one. ----
MINIMAX_ENABLE=true
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_AGENT_MODEL=MiniMax-M2.7-highspeed
MINIMAX_SAFETY_MODEL=MiniMax-M2.5-highspeed
MINIMAX_REQUEST_TIMEOUT=60

OPENROUTER_ENABLE=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v3.2
OPENROUTER_SAFETY_MODEL=deepseek/deepseek-v3.2
OPENROUTER_DIGEST_MODEL=deepseek/deepseek-v3.2
OPENROUTER_REQUEST_TIMEOUT=60
OPENROUTER_DIGEST_TIMEOUT=180

# ---- Embeddings: Google Gemini (3072-dim). KEPT from n8n. ----
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# ---- LLM "training pipeline": KB file -> RAG units (selected LLM digest + Gemini embed). ----
# MINIMAX_DIGEST_MODEL defaults to MINIMAX_AGENT_MODEL when blank.
MINIMAX_DIGEST_MODEL=
# Where uploaded KB originals are persisted (best-effort; raw_text in the DB is the
# source of truth). docker-compose.yml mounts the vfic_kb_uploads volume here.
KB_STORAGE_PATH=/data/kb_uploads
DIGEST_SECTION_CHARS=6000
DIGEST_MAX_SECTIONS=20
INGEST_JOB_TIMEOUT_SECONDS=1800

# ---- Runtime ----
WEB_CONCURRENCY=2
