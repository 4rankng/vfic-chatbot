# ---- App ----
APP_ENV=development
# Comma-separated list of allowed CORS origins (the CRM + dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://bot.tingting.vip

# ---- Database (self-hosted Postgres 16 + pgvector) ----
# DEV (`make dev`): these are rewritten to localhost automatically.
# PROD: docker-compose.yml service name `postgres`; password via POSTGRES_PASSWORD
#       (generated by scripts/prod-env.sh on first deploy).
POSTGRES_USER=vfic
POSTGRES_PASSWORD=vfic
POSTGRES_DB=vfic
# async driver (app runtime)
DATABASE_URL=postgresql+asyncpg://vfic:vfic@postgres:5432/vfic
# sync driver (Alembic + ETL script)
DATABASE_URL_SYNC=postgresql+psycopg://vfic:vfic@postgres:5432/vfic
# Async engine pool. Peak DB conns ≈ (# processes) × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# Production runs ~8 resident DB-touching processes (active web colour,
# worker-chatbot ×3, persistence, ingest, followup, maintenance — the inactive
# colour runs only during a cutover; the scheduler is Redis-only). Compose
# overrides pool sizes (web 8+4, workers 4+2), so the steady state is
# 12 + 6×6 = 48 of Postgres max_connections=150, 60 with both colours up.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- Redis (RQ broker + per-chat mutex + pub/sub) ----
# DEV: no password. PROD: REDIS_PASSWORD set + embedded in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ---- Host allowlist + request limits ----
# Comma-separated Host allowlist (TrustedHostMiddleware). "*" refuses to boot.
ALLOWED_HOSTS=bot.tingting.vip,localhost,127.0.0.1
# Per-client-IP cap on inbound webhook POSTs; fail-open by contract.
RATELIMIT_WEBHOOK_LIMIT=120
RATELIMIT_WEBHOOK_WINDOW_SECONDS=60
# Per-user cap on the LLM/embedding-backed routes (/jobs/search, /rag/test,
# /web-chat-turn, /assist, /chatops-actions/*).
RATELIMIT_LLM_LIMIT=30
RATELIMIT_LLM_WINDOW_SECONDS=60
# true = deny the LLM routes when Redis cannot verify the budget.
RATELIMIT_LLM_FAIL_CLOSED=false

# ---- Auth (JWT, replaces Supabase Auth) ----
JWT_SECRET=change-me-please-32-chars-minimum-aaaa
JWT_ALGORITHM=HS256
# Minted on issue and required on decode. Allowlist for JWT_ALGORITHM is
# HS256/384/512; any other value refuses to boot.
JWT_ISSUER=tingting-api
JWT_AUDIENCE=tingting-api
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
RESEND_API_KEY=
# Password reset OTP emails are sent FROM the code constant
# "TingTing <noreply@tingting.vip>". Verify the tingting.vip sending domain
# in Resend (resend.com → Domains) or sends will be rejected with HTTP 422.
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_ATTEMPT_LIMIT=5

# ---- Zalo Bot Platform (bot-api.zaloplatforms.com) — the single Zalo integration. ----
# NEVER exposed to frontend.
# ZALO_BOT_TOKEN: the Bot Platform bot token (rides in the URL path /bot{TOKEN}/{method}).
#   REQUIRED to send replies. From the Bot Platform console (bot.zaloplatforms.com).
# ZALO_BOT_WEBHOOK_SECRET: the secret_token you passed to setWebhook; Zalo echoes it in
#   the X-Bot-Api-Secret-Token header on every inbound POST. REQUIRED in prod
#   (blank -> webhook fails closed 503 in non-dev).
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_API_BASE=https://bot-api.zaloplatforms.com
ZALO_BOT_REQUEST_TIMEOUT=30
# The webhook URL currently registered with Zalo. Optional; status/self-test only.
ZALO_BOT_WEBHOOK_URL=

# ---- LLM providers (OpenAI-compatible). Enable exactly one. ----
MINIMAX_ENABLE=true
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_AGENT_MODEL=MiniMax-M3.1-Flash-Preview
MINIMAX_EXTRACTOR_MODEL=MiniMax-M2.5-highspeed
MINIMAX_REQUEST_TIMEOUT=60

OPENROUTER_ENABLE=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_EXTRACTOR_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_DIGEST_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_REQUEST_TIMEOUT=60
OPENROUTER_DIGEST_TIMEOUT=180

# ---- Embeddings: Google Gemini (3072-dim). ----
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072

# ---- Dashboard metrics ----
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=30

# ---- Geocoding (project work address + the candidate's stated area) ----
# Providers are tried in order: Google Maps, then Vietmap. There is NO keyless
# provider (Nominatim was removed 2026-10-03 — it answered a factory address
# with the city centroid behind the wrong "1.5 km" distance), so with neither
# key set the catalog reports no distance instead of a guessed one. Both hops
# are fail-open: an outage degrades the answer instead of failing the turn.
GEOCODER_ENABLED=true
GEOCODER_TIMEOUT_SECONDS=3
GEOCODER_CACHE_TTL_SECONDS=2592000
GEOCODER_NEGATIVE_TTL_SECONDS=21600
# Primary hop, and the only reverse-verification source. Measured best on the
# Hải Phòng plants (0.92 km median error vs Vietmap's 2.74 km).
# Blank disables the hop.
GOOGLE_MAPS_API_KEY=
# Second hop and the only provider that takes a region bias. Vietnam-native, so
# it resolves the local landmarks and ward-level entries OSM data misses.
# Blank disables the hop; console: maps.vietmap.vn.
VIETMAP_API_KEY=

# ---- LLM "training pipeline": KB file -> RAG units (selected LLM digest + Gemini embed). ----
# MINIMAX_DIGEST_MODEL defaults to MINIMAX_AGENT_MODEL when blank.
MINIMAX_DIGEST_MODEL=
# Where uploaded KB originals are persisted (best-effort; raw_text in the DB is the
# source of truth). docker-compose.yml mounts the vfic_kb_uploads volume here.
KB_STORAGE_PATH=/data/kb_uploads
DIGEST_SECTION_CHARS=6000
DIGEST_MAX_SECTIONS=20
INGEST_JOB_TIMEOUT_SECONDS=1800

# ---- Runtime ----
WEB_CONCURRENCY=2
# Cross-process provider throttling (Redis semaphores; 0 = disabled/pass-through).
# A turn that can't acquire a token within 30s proceeds anyway (degraded) — no deadlock.
# These defaults cap concurrent LLM/embed calls deployment-wide to shed 429 bursts.
LLM_CONCURRENCY_LIMIT=4
EMBED_CONCURRENCY_LIMIT=6
