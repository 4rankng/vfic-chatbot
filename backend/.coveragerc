# Backend coverage configuration.
#
# Consumed by the CI backend-unit job via:
#   .venv/bin/pytest -m "not integration" --cov --cov-config=.coveragerc --cov-report=term-missing
# pytest-cov is declared in pyproject.toml's dev extra.

[run]
source = app
omit =
    */tests/*
    */alembic/*
    app/workers/run_worker.py

[report]
# Report-only for now: no fail_under yet. The first CI run's measured number
# becomes the ratchet floor; raise it only, never lower.
fail_under = 0
precision = 1
show_missing = true
