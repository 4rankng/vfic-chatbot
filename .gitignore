# =============================================================================
# Root .gitignore — VFIC ATS (ChatBotN8N)
# Stack: React/react-admin frontend, FastAPI/LangGraph backend, self-hosted
#        Postgres+pgvector+Redis, Docker (Caddy edge). macOS/Linux/Windows dev.
# (n8n + Supabase were decommissioned 2026-06-26; see legacy/.)
# Sub-projects keep their own .gitignore (frontend/, backend/) for build output.
# NOTE: do NOT add bare `lib/`, `build/`, or `dist/` here — they match source
#       dirs like frontend/src/lib at depth. Build output is scoped per-project.
# =============================================================================
# Plans: durable records are tracked, per-plan working dirs stay local.
# `plans/reports/` is the completion-record path mandated by AGENTS.md and
# standards/agent-completion-checklist.md; `plans/qa-<date>/` is the QA report
# path mandated by docs/qa-runbook.md. A nested .gitignore cannot re-include a
# path inside an excluded directory, so every rule lives here.
plans/*
!plans/reports/
!plans/qa-*/

# AgentKit: `config.yaml` is the team-shared settings file that
# `.agentkit/.gitignore` itself declares "meant to be committed"; every other
# file in the directory is installer output regenerated by `ak kit init`.
.agentkit/*
!.agentkit/config.yaml

# --- Secrets / env (NEVER commit) ---
.env
.env.*
!.env.example

# --- OS junk ---
.DS_Store
._*
Thumbs.db
ehthumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.cursor/
.codex/

# --- AI agent runtime & orchestration state ---
# Version root shared policy/hooks/skills; keep nested and personal state local.
**/.claude/
!/.claude/
# Every layer of the root .claude/ tree is tracked (agents/, rules/,
# output-styles/, hooks/, skills/); only machine-local state is excluded.
# Hook runtime logs mutate on every hook fire; never track them.
/.claude/hooks/.logs/
/.claude/settings.local.json
/.claude/agent-memory/
.omc/
CLAUDE.local.md

# --- Node (frontend) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Test / coverage artifacts ---
coverage/
.nyc_output/
# Vitest screenshot artifacts (regenerated by screenshot tests; never commit)
**/__screenshots__/

# --- graphify knowledge-graph artifacts (generated, not source) ---
graphify-out/
.graphify-cache/

# --- Misc generated artifacts ---
*.log
*.dump

# --- Repomix dumps (generated mirror of the whole tree; write them to /tmp) ---
repomix-output.xml
.repomix*

# --- Code-review graph database (generated; 150 MB+ when populated) ---
.code-review-graph/

# --- One-off marketing renders (regenerate with assets/showoff/*/capture.mjs) ---
assets/showoff/**/images/

# --- Local one-off QA probes (hardcoded dev paths; same policy as backend/.gitignore) ---
frontend/qa/probe-*.cjs
frontend/qa/qa-audit*.cjs
frontend/qa/ultraqa-sweep.cjs

# --- Production backup bundles (contain LIVE secrets + DB dumps — NEVER commit) ---
# Created by `make backup-full` (scripts/backup-droplet.sh).
backups/
.zcode
.mcp.json
.agentsroom/
.agents/mcp_config.json

# --- OpenWiki run state (machine-local; rewritten by every `make openwiki`) ---
openwiki/.run.json
openwiki/.last-update.json
