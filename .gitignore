# =============================================================================
# Root .gitignore — VFIC ATS (ChatBotN8N)
# Stack: React/react-admin frontend, FastAPI/LangGraph backend, self-hosted
#        Postgres+pgvector+Redis, Docker (Caddy edge). macOS/Linux/Windows dev.
# (n8n + Supabase were decommissioned 2026-06-26; see legacy/.)
# Sub-projects keep their own .gitignore (frontend/, backend/) for build output.
# NOTE: do NOT add bare `lib/`, `build/`, or `dist/` here — they match source
#       dirs like frontend/src/lib at depth. Build output is scoped per-project.
# =============================================================================

# --- Secrets / env (NEVER commit) ---
.env
.env.*
!.env.example

# --- OS junk ---
.DS_Store
._*
Thumbs.db
ehthumbs.db

# --- Editor / IDE ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.cursor/
.codex/

# --- AI agent runtime & orchestration state (local config, not source) ---
.claude/
.omc/
CLAUDE.local.md

# --- Node (frontend) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Test / coverage artifacts ---
coverage/
.nyc_output/
# Vitest screenshot artifacts (regenerated by screenshot tests; never commit)
**/__screenshots__/

# --- graphify knowledge-graph artifacts (generated, not source) ---
graphify-out/
.graphify-cache/

# --- Misc generated artifacts ---
*.log
*.dump
