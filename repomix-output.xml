    def test_all_fields_returns_empty(self):
        lead = {
            "name": "Dũng",
            "phone": "0987",
            "desired_job": "kho",
            "region": "HP",
            "living_area": "An Lão",
            "expected_salary": "8tr",
            "notes": "xăm kín",
        }
