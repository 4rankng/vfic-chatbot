DATABASE_URL_SYNC=postgresql+psycopg://vfic:vfic@postgres:5432/vfic
# Async engine pool. Peak DB conns ≈ (# processes) × (DB_POOL_SIZE + DB_MAX_OVERFLOW).
# With ~13 DB-touching processes at 10+10, set Postgres max_connections ≥150.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

