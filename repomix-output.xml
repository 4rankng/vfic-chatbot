            "faq",
            {"topic": "yêu cầu"},
        ),
    ]

    for i, doc in enumerate(docs):
        # 2-3 chunks per document
        for j in range(rng.randint(2, 3)):
            spec = chunk_specs[(i * 3 + j) % len(chunk_specs)]
            chunks.append(
                KnowledgeChunk(
                    id=_uuid(),
