        lead = {
            "name": "Dũng",
            "phone": "0987",
            "desired_job": "kho",
            "region": "Hải Phòng",
            "living_area": "An Lão",
        }
        q = self._ask(lead=lead, current_user_text="ok", recent_messages=[])
