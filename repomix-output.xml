        oa_refresh_token="oa-refresh",
    )

    result = await integrations.test_zalo_oa(_admin=object(), db=object())

    assert result.connected is True
    assert result.errors == []
    assert calls == ["get:oa-token-old", "refresh", "get:oa-token-new"]


