class TestNormalizeLead:
    def test_full_extraction(self):
        raw = '{"name": "Dũng", "phone": "0357210887", "desired_job": "công nhân", "region": "Hải Phòng"}'
        result = normalize_lead(raw, "zalo_123")
        assert result is not None
