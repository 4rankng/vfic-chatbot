        filename = f"{filename}.md"
    fallback_filename = filename.encode("ascii", "ignore").decode() or "knowledge-source.md"
    return PlainTextResponse(
        doc.raw_text or "",
        media_type="text/markdown; charset=utf-8",
        headers={
