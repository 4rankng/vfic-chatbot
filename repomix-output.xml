       stage_timings-&gt;&gt;'outbound_prepare_ms' AS outbound_prepare_ms,
       stage_timings-&gt;&gt;'outbound_provider_ms' AS outbound_provider_ms,
       stage_timings-&gt;&gt;'outbound_provider_attempts' AS outbound_provider_attempts,
       stage_timings-&gt;&gt;'outbound_retry_count' AS outbound_retry_count,
       stage_timings-&gt;&gt;'outbound_retry_ms' AS outbound_retry_ms,
       stage_timings-&gt;&gt;'outbound_refresh_count' AS outbound_refresh_count,
       stage_timings-&gt;&gt;'outbound_refresh_ms' AS outbound_refresh_ms,
       stage_timings-&gt;&gt;'outbound_chunk_count' AS outbound_chunk_count,
       stage_timings-&gt;&gt;'outbound_result' AS outbound_result,
       stage_timings-&gt;&gt;'total_ms'    AS total_ms,
       stage_timings-&gt;&gt;'queue_depth' AS queue_depth
FROM bot_runs
WHERE conversation_id = (SELECT id FROM conversations
                         WHERE zalo_chat_id = :chat_id)
ORDER BY started_at DESC LIMIT 5;</pre>
        <p class="sub" style="margin-left:0"><code>outcome</code> SENT / SUPPRESSED / ERROR. <code>llm_ms</code> dominates slow turns (12). The <code>outbound_*</code> fields are channel-neutral adapter metadata: they contain no message text, recipient ID, token, or provider envelope. <code>outbound_provider_ms</code> ends at the provider API response; it does not prove device rendering. If <code>version_at_start</code> &lt; current <code>conversations.version</code> yet <code>outcome = SENT</code>, a stale reply may have slipped past the ownership guard (14).</p>

        <p class="qlabel"><span class="num">d</span>Stuck-PENDING sweep + dedup — blocks 3, 9, ♻</p>
<pre class="sql">-- stuck BOT replies older than 5 min (reconcile targets)
SELECT c.zalo_chat_id, c.bot_locked_until,
       m.id, m.delivery_status, m.created_at
FROM messages m
JOIN conversations c ON c.id = m.conversation_id
WHERE m.sender = 'BOT' AND m.delivery_status = 'PENDING'
  AND m.created_at &lt; now() - interval '5 minutes';

-- dedup window for one chat
SELECT chat_id, msg_hash, created_at
FROM message_dedup
WHERE chat_id = :chat_id
ORDER BY created_at DESC LIMIT 10;</pre>
