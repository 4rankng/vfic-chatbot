    """Redis failure must NOT propagate — instrumentation is best-effort."""

    async def raising():
        raise RuntimeError("redis down")

    monkeypatch.setattr("app.core.redis.get_redis", raising)
    # Should not raise.
    await slo_service.record_webhook_ack_ms(75.0)


