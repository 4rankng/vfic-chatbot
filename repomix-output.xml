    <div class="endpoints reveal d2" style="margin-top:26px">
      <div class="ep-card">
        <div class="path">POST /webhooks/zalo/chatbot</div>
        <div class="vi" style="font-size:.86rem;color:var(--ink-soft);margin-bottom:10px"><strong>Bot Platform</strong> — secret chung <code>X-Bot-Api-Secret-Token</code> (echo do Zalo gửi lại).</div>
        <div class="en" style="font-size:.86rem;color:var(--ink-soft);margin-bottom:10px"><strong>Bot Platform</strong> — shared secret <code>X-Bot-Api-Secret-Token</code> (echoed by Zalo).</div>
        <div class="sig">hmac.compare_digest(token, bot_webhook_secret)</div>
      </div>
      <div class="ep-card">
        <div class="path">POST /webhooks/zalo/oa</div>
