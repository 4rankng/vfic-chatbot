<script>
(function(){
  "use strict";
  var root=document.documentElement, body=document.body;

  /* ---------- THEME ---------- */
  var THEMES=["dark","light","system"], LABELS={dark:"DARK",light:"LIGHT",system:"AUTO"};
  var ti=0;
  try{ var saved=localStorage.getItem("tt-theme"); if(saved){ ti=Math.max(0,THEMES.indexOf(saved)); } }catch(e){}
  function applyTheme(){
    root.setAttribute("data-theme", THEMES[ti]);
    var lbl=document.getElementById("theme-label"); if(lbl) lbl.textContent=LABELS[THEMES[ti]];
    try{ localStorage.setItem("tt-theme", THEMES[ti]); }catch(e){}
  }
  applyTheme();
  var tbtn=document.getElementById("theme-cycle");
  if(tbtn) tbtn.addEventListener("click", function(){ ti=(ti+1)%THEMES.length; applyTheme(); });

  /* ---------- LANGUAGE ---------- */
  function setLang(l){
    body.classList.toggle("lang-vi", l==="vi");
    body.classList.toggle("lang-en", l==="en");
    root.setAttribute("lang", l);
    var a=document.getElementById("lang-vi"), b=document.getElementById("lang-en");
    if(a) a.setAttribute("aria-pressed", l==="vi");
    if(b) b.setAttribute("aria-pressed", l==="en");
    try{ localStorage.setItem("tt-lang", l); }catch(e){}
  }
  var initLang="vi";
  try{ var sl=localStorage.getItem("tt-lang"); if(sl==="en"||sl==="vi") initLang=sl; }catch(e){}
  setLang(initLang);
  var lv=document.getElementById("lang-vi"), le=document.getElementById("lang-en");
  if(lv) lv.addEventListener("click", function(){setLang("vi");});
  if(le) le.addEventListener("click", function(){setLang("en");});

  /* ---------- REVEAL + RAIL ---------- */
  var io=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add("in"); }
    });
  },{threshold:0.12});
  document.querySelectorAll(".reveal").forEach(function(el){ io.observe(el); });
  // Safety net: guarantee nothing stays hidden if captured beyond the viewport
  // (element screenshots render the full section, where IO may not have fired).
  window.addEventListener("load", function(){
    setTimeout(function(){
      document.querySelectorAll(".reveal:not(.in)").forEach(function(el){ el.classList.add("in"); });
    }, 700);
  });

  var railLinks=Array.prototype.slice.call(document.querySelectorAll(".rail a"));
  var secs=railLinks.map(function(a){ return document.querySelector(a.getAttribute("href")); });
  var rio=new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        var idx=secs.indexOf(e.target);
        railLinks.forEach(function(l,i){ l.classList.toggle("active", i===idx); });
      }
    });
  },{threshold:0.4});
  secs.forEach(function(s){ if(s) rio.observe(s); });
})();
</script>
</body>
</html>
