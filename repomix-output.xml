        "### Bus Route: R\n\nroute_id: r\nroute_group: G\nroute_name: R\nshift: day\ndirection: outbound\n\n"
        + block.split("### Bus Route: Test route\n\n", 1)[1]
    )
    result = repair_canonical_markdown(text)
