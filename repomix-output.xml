        q=body.q,
        sort_by=body.sort,
        order=body.order,
    )
    return LeadBoardResponse(
        sections=[
            LeadBoardSection(
                key=section["key"],
                title=section["title"],
                data=[LeadOut.model_validate(row) for row in section["data"]],
                total=section["total"],
                page=section["page"],
                per_page=section["per_page"],
                is_priority=section["is_priority"],
            )
            for section in sections
