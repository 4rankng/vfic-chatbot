.metrics{display:flex; flex-wrap:wrap; gap:12px; margin-top:28px}
.metric{
  display:flex; flex-direction:column; gap:2px; min-width:128px;
  padding:14px 16px; border-radius:var(--r-md);
  background:var(--panel); border:1px solid var(--stroke);
}
.metric b{font-family:var(--font-display);font-size:1.5rem;font-weight:800;line-height:1}
.metric span{font-size:.78rem;color:var(--ink-faint);font-family:var(--font-mono);letter-spacing:.03em}

code,kbd,.mono{font-family:var(--font-mono)}
.snippet{
  font-family:var(--font-mono); font-size:.82rem; line-height:1.7;
  background:var(--bg-2); border:1px solid var(--stroke); border-radius:var(--r-md);
  padding:16px 18px; color:var(--ink-soft); overflow:auto; white-space:pre;
}
.snippet .k{color:var(--c-backend)}
.snippet .s{color:var(--c-user)}
.snippet .c{color:var(--ink-faint)}

/* ============================================================
   HERO FLOW DIAGRAM
   ============================================================ */
.hero{flex-direction:column; gap:clamp(28px,5vh,56px)}
.hero h1{max-width:16ch}
.hero .lead{max-width:68ch}
.flowtube{
  position:relative; width:100%; max-width:1180px; margin-top:8px;
  border:1px solid var(--stroke); border-radius:var(--r-xl);
  background:linear-gradient(180deg,var(--panel),transparent);
  padding:clamp(22px,3vw,38px) clamp(16px,3vw,34px);
  box-shadow:var(--shadow);
}
.flow{display:grid; grid-template-columns:repeat(5,1fr); gap:8px; position:relative; z-index:2}
@media (max-width:820px){.flow{grid-template-columns:1fr; gap:6px}}
.node{
  position:relative; display:flex; flex-direction:column; align-items:center; text-align:center;
  gap:10px; padding:14px 8px;
}
.node .orb{
  width:clamp(58px,7vw,84px); height:clamp(58px,7vw,84px); border-radius:24px;
  display:grid; place-items:center; position:relative;
  background:var(--bg-2); border:1px solid var(--stroke-2);
  box-shadow:0 0 0 6px rgba(255,255,255,.02), inset 0 0 24px rgba(255,255,255,.03);
}
.node .orb::after{content:"";position:absolute;inset:-2px;border-radius:26px;opacity:.55;filter:blur(10px);z-index:-1}
.node.n1 .orb{border-color:rgba(245,158,11,.6)} .node.n1 .orb::after{background:var(--c-recruiter)}
.node.n2 .orb{border-color:rgba(99,102,241,.6)} .node.n2 .orb::after{background:var(--c-frontend)}
.node.n3 .orb{border-color:rgba(20,184,166,.65)} .node.n3 .orb::after{background:var(--c-backend)}
.node.n4 .orb{border-color:rgba(14,165,233,.6)} .node.n4 .orb::after{background:var(--c-oa)}
.node.n5 .orb{border-color:rgba(34,211,238,.6)} .node.n5 .orb::after{background:var(--c-user)}
.node .orb svg{width:46%;height:46%}
.node .lbl{font-family:var(--font-display);font-weight:700;font-size:.98rem;line-height:1.1}
.node .sub{font-family:var(--font-mono);font-size:.7rem;letter-spacing:.05em;color:var(--ink-faint);text-transform:uppercase}
.wire{position:absolute; top:clamp(29px,3.5vw,42px); left:0; right:0; height:2px; z-index:1; pointer-events:none}
.wire .track{position:absolute;inset:0;background:linear-gradient(90deg,transparent,var(--stroke-2),transparent)}
.wire .pkt{position:absolute;top:-3px;width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 12px 3px currentColor}
.wire .p1{color:var(--c-frontend);animation:ride 4.2s linear infinite}
.wire .p2{color:var(--c-backend);animation:ride 4.2s linear 1.4s infinite}
.wire .p3{color:var(--c-oa);animation:ride 4.2s linear 2.8s infinite}
.wire .back{color:var(--c-user);animation:rideR 5.4s linear .7s infinite}
@keyframes ride{0%{left:0%;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:100%;opacity:0}}
@keyframes rideR{0%{left:100%;opacity:0}8%{opacity:1}92%{opacity:1}100%{left:0%;opacity:0}}
@media (max-width:820px){.wire{display:none}}

/* ============================================================
   COCKPIT MOCKUP (recruiter frontend)
   ============================================================ */
.cockpit{
  display:grid; grid-template-columns:1.05fr .95fr; gap:26px; align-items:stretch;
}
@media (max-width:980px){.cockpit{grid-template-columns:1fr}}
.mock{
  border:1px solid var(--stroke-2); border-radius:var(--r-lg); overflow:hidden;
  background:var(--bg-2); box-shadow:var(--shadow); min-height:340px;
  display:flex;
}
.mock .col-list{flex:0 0 38%; border-right:1px solid var(--stroke); display:flex; flex-direction:column}
.mock .col-list .hd{padding:13px 15px; border-bottom:1px solid var(--stroke); font:700 .82rem var(--font-display); display:flex;justify-content:space-between;align-items:center}
.mock .col-list .hd .badge{font:700 .66rem var(--font-mono);background:var(--c-recruiter);color:#1a1206;padding:2px 7px;border-radius:999px}
.mock .row{padding:11px 15px; border-bottom:1px solid var(--stroke); display:flex; flex-direction:column; gap:2px}
.mock .row.on{background:var(--panel-2); border-left:3px solid var(--c-backend)}
.mock .row .nm{font-size:.8rem;font-weight:600}
.mock .row .pv{font:.68rem var(--font-mono);color:var(--ink-faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mock .col-thread{flex:1; display:flex; flex-direction:column}
.mock .col-thread .hd{padding:13px 15px;border-bottom:1px solid var(--stroke);display:flex;justify-content:space-between;align-items:center}
.mock .col-thread .hd .who{font:700 .85rem var(--font-display)}
.mock .col-thread .hd .take{font:700 .66rem var(--font-mono);color:var(--c-recruiter)}
.mock .thread{flex:1; padding:14px 15px; display:flex; flex-direction:column; gap:10px; justify-content:flex-end}
.bubble{max-width:78%; padding:9px 13px; border-radius:14px; font-size:.82rem; line-height:1.4}
.bubble.in{align-self:flex-start; background:var(--panel-2); border:1px solid var(--stroke); border-bottom-left-radius:4px}
.bubble.out{align-self:flex-end; color:#04121a; border-bottom-right-radius:4px}
.bubble.out.bot{background:linear-gradient(135deg,var(--c-backend),#0ea5e9)}
.bubble.out.human{background:linear-gradient(135deg,var(--c-recruiter),#fbbf24)}
.bubble .t{font:.62rem var(--font-mono);opacity:.7;margin-top:3px;display:block}
.mock .composer{border-top:1px solid var(--stroke); padding:10px 12px; display:flex; gap:8px; align-items:center}
.mock .composer .field{flex:1; height:32px; border-radius:9px; background:var(--panel); border:1px solid var(--stroke)}
.mock .composer .send{width:32px;height:32px;border-radius:9px;background:var(--grad-journey);display:grid;place-items:center}

.socket-note{display:flex;gap:12px;align-items:flex-start;margin-top:18px;font-size:.86rem;color:var(--ink-soft)}
.socket-note .pulse{flex:0 0 auto;width:10px;height:10px;border-radius:50%;background:var(--c-backend);margin-top:5px;box-shadow:0 0 0 0 var(--c-backend);animation:pulse 2.4s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(20,184,166,.5)}70%{box-shadow:0 0 0 12px rgba(20,184,166,0)}100%{box-shadow:0 0 0 0 rgba(20,184,166,0)}}

/* ============================================================
   PIPELINE (backend brain)
   ============================================================ */
.pipeline{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.pipe-step{
  display:grid; grid-template-columns:auto 1fr auto; gap:16px; align-items:center;
  padding:14px 18px; border:1px solid var(--stroke); border-radius:var(--r-md);
  background:var(--panel); position:relative;
}
.pipe-step .idx{font:800 .9rem var(--font-mono);color:var(--ink-faint);width:30px}
.pipe-step .ttl{font-weight:600;font-size:.98rem}
.pipe-step .ttl code{font-size:.82rem;color:var(--c-backend)}
.pipe-step .tag{font:600 .64rem var(--font-mono);letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:999px;background:var(--panel-2);border:1px solid var(--stroke);color:var(--ink-soft);white-space:nowrap}
.pipe-step.hot{border-color:rgba(20,184,166,.4)}
.pipe-step.hot .tag{color:var(--c-backend);border-color:rgba(20,184,166,.4)}
.pipe-step.guard{border-color:rgba(245,158,11,.4)}
.pipe-step.guard .tag{color:var(--c-recruiter);border-color:rgba(245,158,11,.4)}
@media (max-width:640px){.pipe-step{grid-template-columns:auto 1fr}.pipe-step .tag{grid-column:2}}

/* ============================================================
   BRIDGE (Zalo OA sender)
   ============================================================ */
.bridge{display:grid;grid-template-columns:1fr .9fr;gap:26px;align-items:center}
@media (max-width:980px){.bridge{grid-template-columns:1fr}}
.dispatch{
  border:1px solid var(--stroke); border-radius:var(--r-lg); background:var(--panel);
  padding:22px; display:flex; flex-direction:column; gap:16px;
}
.dispatch .hub{
  align-self:center; padding:12px 16px; border-radius:14px; font:700 .9rem var(--font-mono);
  border:1px dashed var(--stroke-2); background:var(--bg-2);
}
.dispatch .branches{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.branch{border:1px solid var(--stroke);border-radius:var(--r-md);padding:14px;background:var(--bg-2)}
.branch h4{margin:0 0 4px;font:700 .85rem var(--font-display);display:flex;align-items:center;gap:8px}
.branch h4 i{width:8px;height:8px;border-radius:50%}
.branch .ep{font:.7rem var(--font-mono);color:var(--ink-faint);margin-top:8px;word-break:break-all}

/* ============================================================
   GUARD CHAIN (webhooks)
   ============================================================ */
.endpoints{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:22px}
@media (max-width:760px){.endpoints{grid-template-columns:1fr}}
.ep-card{border:1px solid var(--stroke);border-radius:var(--r-lg);padding:18px;background:var(--panel)}
.ep-card .path{font:600 .82rem var(--font-mono);color:var(--ink);margin-bottom:10px;word-break:break-all}
.ep-card .sig{font:.72rem var(--font-mono);color:var(--ink-soft);background:var(--bg-2);border:1px solid var(--stroke);border-radius:8px;padding:9px 11px;word-break:break-all}
.chain{display:flex;flex-wrap:wrap;align-items:stretch;gap:0;margin-top:6px}
.chain .step{
  flex:1; min-width:120px; padding:14px 12px; position:relative;
  border:1px solid var(--stroke); border-right:none; background:var(--panel);
  font-size:.82rem; text-align:center;
}
.chain .step:first-child{border-radius:var(--r-md) 0 0 var(--r-md)}
.chain .step:last-child{border-right:1px solid var(--stroke);border-radius:0 var(--r-md) var(--r-md) 0}
.chain .step b{display:block;font:700 .8rem var(--font-mono);color:var(--c-backend);margin-bottom:3px}
.chain .step::after{
  content:"›"; position:absolute; right:-8px; top:50%; transform:translateY(-50%);
  font-size:1.2rem; color:var(--ink-faint); z-index:3; background:var(--bg); padding:0 2px;
}
.chain .step:last-child::after{display:none}
@media (max-width:900px){.chain{flex-direction:column}.chain .step{border-right:1px solid var(--stroke);border-bottom:none;border-radius:0}.chain .step::after{content:"⌄";right:50%;top:auto;bottom:-12px;transform:translateX(50%)}.chain .step:first-child{border-radius:var(--r-md) var(--r-md) 0 0}.chain .step:last-child{border-radius:0 0 var(--r-md) var(--r-md)}}

/* ============================================================
   E2E / INVARIANTS
   ============================================================ */
.lifecycle{
  border:1px solid var(--stroke); border-radius:var(--r-xl); background:var(--panel);
  padding:clamp(18px,2.4vw,30px); box-shadow:var(--shadow); margin-top:8px;
}
.bidir{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:820px){.bidir{grid-template-columns:1fr}}
.lane{border:1px solid var(--stroke);border-radius:var(--r-md);padding:18px;background:var(--bg-2)}
.lane h4{margin:0 0 12px;font:700 .92rem var(--font-display);display:flex;align-items:center;gap:9px}
.lane h4 .arr{font-family:var(--font-mono)}
.lane ol{margin:0;padding-left:18px}
.lane li{font-size:.84rem;color:var(--ink-soft);margin-bottom:7px;line-height:1.5}
.lane li b{color:var(--ink);font-weight:600;font-family:var(--font-mono);font-size:.8rem}

/* ============================================================
   FOOTER
   ============================================================ */
footer{
  position:relative; z-index:1; padding:60px clamp(20px,6vw,80px) 80px;
  border-top:1px solid var(--stroke);
}
footer .wrap{max-width:1240px}
footer h4{font:700 .82rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint);margin:0 0 16px}
footer .refs{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px 22px;list-style:none;padding:0;margin:0}
footer .refs li{font-size:.82rem;color:var(--ink-soft)}
footer .refs a{color:var(--c-backend);text-decoration:none;border-bottom:1px dotted var(--stroke-2)}
footer .refs a:hover{color:var(--c-user)}
footer .sig{margin-top:34px;font:600 .78rem var(--font-mono);color:var(--ink-faint);letter-spacing:.04em}
footer .sig b{font-family:var(--font-display);color:var(--ink)}

/* accessibility / motion */
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important; scroll-behavior:auto !important}
  .reveal{opacity:1;transform:none}
}
</style>
</head>
