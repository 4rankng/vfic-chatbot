    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const currentFileIds = [...new Set(\n  $input.all()\n    .map((item) => String(item.json?.id ?? '').trim())\n    .filter(Boolean)\n)];\n\nreturn [{\n  json: {\n    current_file_ids: currentFileIds,\n    current_file_count: currentFileIds.length,\n  },\n}];"
      },
