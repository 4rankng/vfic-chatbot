      "id": "93c9a2ac-3a3b-45d4-b1db-e12b18304a65",
      "name": "Collect Current Drive Files",
      "notesInFlow": true,
      "notes": "Collapses the Google Drive search results into a single item that contains the current Drive file IDs for reconcile/deletion checks."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const allItems = $input.all();\nconst currentIds = new Set(\n  (allItems.find((item) => Array.isArray(item.json?.current_file_ids))?.json?.current_file_ids ?? [])\n    .map((value) => String(value).trim())\n    .filter(Boolean)\n);\nconst stale = new Set();\n\nfor (const item of allItems) {\n  const driveFileId = item.json?.drive_file_id ? String(item.json.drive_file_id).trim() : '';\n  if (driveFileId && !currentIds.has(driveFileId)) {\n    stale.add(driveFileId);\n  }\n}\n\nreturn [...stale].map((drive_file_id) => ({\n  json: { drive_file_id },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
