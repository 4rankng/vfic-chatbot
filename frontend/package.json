{
  "name": "atomic-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:unit:app": "vitest --config vitest.config.ts --project app",
    "test:unit:app:coverage:changed-surface": "vitest --config vitest.config.ts --project app --coverage",
    "test:unit:app:coverage": "npm run test:unit:app:coverage:changed-surface --",
    "test:unit:claude": "vitest --config vitest.config.ts --project claude",
    "test:e2e:desktop": "playwright test --config playwright.config.ts --project chromium",
    "test:e2e:mobile": "playwright test --config playwright.config.ts --project \"Mobile Chrome\"",
    "dev": "vite --force",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:e2e": "vite build --mode e2e",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "preview": "vite preview",
    "lint:apply": "eslint **/*.{mjs,ts,tsx} --no-warn-ignored --fix",
    "lint": "eslint **/*.{mjs,ts,tsx} --no-warn-ignored",
    "prettier:apply": "prettier --config ./.prettierrc.json --write --list-different \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "prettier": "prettier --config ./.prettierrc.json --check \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "registry:check": "node ./scripts/check-registry-paths.mjs",
    "registry:build": "npm run registry:check && npx shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
