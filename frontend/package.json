{
  "name": "atomic-crm",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:unit:app": "vitest --config vitest.config.ts --project app",
    "test:unit:app:coverage:changed-surface": "vitest --config vitest.config.ts --project app --coverage",
    "test:unit:app:coverage": "npm run test:unit:app:coverage:changed-surface --",
    "test:e2e:desktop": "playwright test --config playwright.config.ts --project chromium",
    "test:e2e:mobile": "playwright test --config playwright.config.ts --project \"Mobile Chrome\"",
    "test:e2e:visual": "playwright test --config playwright.config.ts --project visual-desktop --project visual-mobile",
    "dev": "vite --force",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:e2e": "vite build --mode e2e",
    "smoke:built": "node ./scripts/smoke-built-bundle.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "typecheck:node": "tsc --noEmit --project tsconfig.node.json",
    "preview": "vite preview",
    "lint:apply": "eslint \"**/*.{mjs,ts,tsx}\" --no-warn-ignored --fix",
    "lint": "eslint \"**/*.{mjs,ts,tsx}\" --no-warn-ignored",
    "prettier:apply": "prettier --config ./.prettierrc.json --write --list-different \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "prettier": "prettier --config ./.prettierrc.json --check \"**/*.{mjs,js,json,ts,tsx,css,md,html}\"",
    "registry:check": "node ./scripts/check-registry-paths.mjs",
    "registry:build": "npm run registry:check && npx shadcn build",
    "registry:gen": "node ./scripts/generate-registry.mjs",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-aria/utils": "^3.34.1",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "inflection": "^3.0.2",
    "input-otp": "^1.5.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "query-string": "^9.5.1",
    "ra-core": "^5.15.4",
    "ra-i18n-polyglot": "^5.15.4",
    "react": "^19.2.4",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.4",
    "react-dropzone": "^20.1.2",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.88.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "react-stately": "^3.50.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "virtua": "^0.52.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.2.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/browser-preview": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "daisyui": "^5.7.46",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-simple-html": "^1.1.0",
    "vitest": "5.0.2",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "decode-uri-component": "0.2.2"
  }
}
