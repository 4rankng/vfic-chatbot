# The @vitest/* browser packages pin exact-version peer deps on `vitest` (e.g.
# `peer vitest@4.1.10`), which npm v7+'s strict peer resolver rejects during
# re-resolution even when every package is aligned on the same version. This is
# the standard project config for the vitest browser ecosystem and lets install
# resolve cleanly. Versions still move together (all @vitest/* + vitest at the
# same release), so peers are satisfied in practice.
legacy-peer-deps=true
